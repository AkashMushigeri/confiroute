# ===========================================================================
# ConfiRoute Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# NEVER commit actual secrets or production credentials to version control.
# ===========================================================================

# --- Application Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database Configuration ---
# 1. Local Development (SQLite):
# Leave DATABASE_URL blank or set to sqlite:///data/confiroute.db
DATABASE_URL=sqlite:///data/confiroute.db

# 2. Cloud Production (Supabase PostgreSQL):
# Format: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler (Port 6543):
# DATABASE_URL=postgresql+psycopg2://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase API credentials (optional for Direct PostgreSQL, required if using Supabase client libraries)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- LLM Providers & API Keys ---
# Groq (Free Tier Cloud Inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini (Optional Cloud Provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (Local LLM Inference)
OLLAMA_BASE_URL=http://localhost:11434

# --- System Security ---
# Secret key used for cryptographic operations and session encryption
SECRET_KEY=confiroute_production_super_secret_jwt_key_change_in_production
