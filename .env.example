# ConfiRoute Environment Variables
# Real API keys are only needed for future phases (Phase 2+ real LLM evaluation).
# Zero-cost setup: free tier Groq API key, Ollama runs locally without key.

GROQ_API_KEY=your_free_groq_api_key_here
GEMINI_API_KEY=your_optional_free_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
ENVIRONMENT=development
LOG_LEVEL=INFO
